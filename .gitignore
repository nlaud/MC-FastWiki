# Loop state of the TODO workflow
.claude/todo/

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Node
node_modules/

# Web build output
web/dist/

# Data tree
# The pipeline writes intermediate files to /data/.cache. Git must not track
# them. The pipeline writes the site payload to /data/dist, and Git tracks that
# directory on purpose. The web build reads /data/dist and nothing else, so a
# deployment needs no pipeline run. Do not add a bare `dist/` rule to this file.
# Such a rule also matches /data/dist and breaks the static build.
# tests/test_repo_invariants.py fails when one half of this rule breaks.
/data/.cache/

# Lavish review surfaces. Scratch artifacts for plan review, not project content.
.lavish/

# Build diagnostics. The pipeline regenerates these; they are not site payload.
/data/reports/
