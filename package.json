{
  "name": "mc-fastwiki",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Fast, keyboard-driven Minecraft Java Edition reference. Static site, no UI framework.",
  "license": "CC-BY-NC-SA-3.0",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-schema-types.js && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "schema:types": "node scripts/generate-schema-types.js",
    "schema:check": "node scripts/generate-schema-types.js --check",
    "test": "node scripts/generate-schema-types.js --check && vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "^1.0.19"
  }
}
