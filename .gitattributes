# Auto detect text files, and normalize them to LF in the repository.
#
# `eol=lf` is the load-bearing half. With `text=auto` alone the working-tree
# ending is left to `core.autocrlf`, which the Git for Windows installer turns
# on by default, so a fresh clone on Windows checks every file out as CRLF.
# Prettier's `endOfLine` defaults to `lf`, so `pnpm format:check` then reports
# every file it reads, and `git checkout -- <file>` re-breaks one file at a
# time after that. `eol=lf` gives the same working tree on every platform.
#
# Binary files are unaffected: `text=auto` detects them and Git skips the
# conversion, so the sprite atlas and the fonts stay byte-exact.
* text=auto eol=lf

# Collapse the pipeline output in a GitHub review.
#
# `/data/dist` holds generated files. Every Minecraft release rewrites them,
# and no person writes a line of them. GitHub hides a file behind a "Load diff"
# control only when `.gitattributes` marks that file as generated. Without the
# mark, thousands of machine-written lines bury the hand-written change in the
# same pull request. The mark also drops these files from the language
# statistics of the repository, so generated JSON does not decide the reported
# language.
#
# Do not use `-diff` here. `-diff` makes Git read the file as binary, so
# `git diff` and `git log -p` print "Binary files differ" and show no content
# at all. The rule below changes no local Git command.
#
# The pattern is anchored to the directory of this file, the way it is in
# `.gitignore`, and it is the embedded slashes that anchor it, not the leading
# one: `data/dist/**` would match the same paths. Keep the leading slash for
# the reader, but do not rely on it to hold the pattern down. What does widen
# the match is a prefix -- `**/dist/**` or `*dist/**` would take `web/dist` and
# every other `dist` directory with it. `/data/curated`, `web/dist`, and
# `web/types` keep the attributes they have now.
#
# The rule sets neither `text` nor `eol`, so the line above still decides the
# line endings of these files.
/data/dist/** linguist-generated=true

# Collapse the mcmeta snapshots of the extract tests for the same reason.
#
# `tests/fixtures/build_block_tag_snapshot.py` writes these two files, and they
# are 6,405 lines of them. A pull request that raises the pinned Minecraft
# version rewrites both, so the hand-written half of that change sits under
# thousands of machine-written lines unless GitHub collapses them.
#
# They sit outside `/data/dist` because they are test input, not site output.
# The mark is the same, and so is the reason for it.
#
# The glob carries the version, the way the `.prettierignore` rule does: the
# next snapshot arrives as `mcmeta_26_3_block_tags.json`. The other files of
# `tests/fixtures/` are hand-written and must stay in the diff.
/tests/fixtures/mcmeta_*_block_tags.json linguist-generated=true
/tests/fixtures/mcmeta_*_block_harvest.json linguist-generated=true

# Collapse the wiki Bucket row snapshot of the enrich tests, for the reason
# above: `tests/fixtures/build_bucket_row_snapshot.py` writes it, it is several
# thousand lines, and a refresh rewrites all of them at once.
/tests/fixtures/wiki_bucket_rows.json linguist-generated=true
